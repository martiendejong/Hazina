{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Authentication": {
    "Enabled": true,
    "Username": "admin",
    "Password": "changeme",
    "Realm": "Terminal Orchestration"
  },

  "AgenticOrchestration": {
    "DatabasePath": "./data/orchestration.db",
    "LogsPath": "./logs",
    "EntitiesYamlPath": "entities.yaml",

    "SignalR": {
      "Enabled": true,
      "HubPath": "/hubs/agentic"
    },

    "Polling": {
      "InstanceHeartbeatTimeoutSeconds": 60,
      "InteractionExpiryMinutes": 60
    },

    "Features": {
      "EnableTaskQueue": true,
      "EnableOutputStreaming": true,
      "EnableRealtimeNotifications": true
    },

    "Terminal": {
      "DefaultCommand": "",
      "DefaultWorkingDirectory": ".",
      "DefaultArguments": [],
      "DefaultColumns": 120,
      "DefaultRows": 30,
      "MaxConcurrentSessions": 10,
      "SessionTimeoutMinutes": 60
    },

    "SessionLogging": {
      "Enabled": true,
      "BasePath": "./logs/sessions"
    }
  },

  "Swagger": {
    "Enabled": true,
    "Title": "Terminal Orchestration API",
    "Description": "Web API for managing AI terminal sessions",
    "Version": "v1"
  }
}
