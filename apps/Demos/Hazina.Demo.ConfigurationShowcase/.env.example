# Hazina Configuration Showcase - Environment Variables Example
# Copy this file to .env and fill in your actual values

# ==========================================
# LLM PROVIDERS (At least one required)
# ==========================================

# OpenAI (Required for most features)
OPENAI_API_KEY=sk-proj-...

# Anthropic (Optional, recommended for failover)
ANTHROPIC_API_KEY=sk-ant-...

# Ollama (Optional, for local inference)
OLLAMA_URL=http://localhost:11434

# ==========================================
# STORAGE: SUPABASE (Optional)
# ==========================================

# Get these from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Get this from: https://supabase.com/dashboard/project/_/settings/database
# Format: Host=db.your-project.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=your-password
SUPABASE_CONNECTION_STRING=Host=db.your-project.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=...

# Or use the pooler connection string for better performance
# SUPABASE_CONNECTION_STRING=Host=aws-0-eu-central-1.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.your-project;Password=...

# ==========================================
# STORAGE: POSTGRESQL (Optional)
# ==========================================

# Self-hosted PostgreSQL
# POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=hazina;Username=hazina_user;Password=your_password

# ==========================================
# STORAGE: FILE-BASED (Default)
# ==========================================

# Local file storage path
# HAZINA_PROJECTS_FOLDER=C:\HazinaData
# Or on Linux/Mac:
# HAZINA_PROJECTS_FOLDER=/var/lib/hazina/data

# ==========================================
# MONITORING (Optional)
# ==========================================

# Budget limit in USD
# HAZINA_BUDGET_USD=100.0

# Health check interval in seconds
# HAZINA_HEALTH_CHECK_INTERVAL=60

# ==========================================
# ADVANCED (Optional)
# ==========================================

# Logging level: Trace, Debug, Information, Warning, Error, Critical
# HAZINA_LOG_LEVEL=Information

# Maximum parallel requests
# HAZINA_MAX_PARALLEL_REQUESTS=10

# Request timeout in seconds
# HAZINA_REQUEST_TIMEOUT_SECONDS=30
