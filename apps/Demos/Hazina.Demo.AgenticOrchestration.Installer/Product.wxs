<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <?define ProductName = "Hazina Agentic Orchestration" ?>
  <?define ProductVersion = "2.4.2" ?>
  <?define Manufacturer = "Hazina Framework" ?>
  <?define UpgradeCode = "12345678-1234-1234-1234-123456789012" ?>

  <Product Id="*"
           Name="$(var.ProductName)"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="$(var.Manufacturer)"
           UpgradeCode="$(var.UpgradeCode)">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perUser"
             Description="$(var.ProductName) Installer"
             Comments="Installs Hazina Agentic Orchestration - Desktop Tray Application" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Feature: Main Application -->
    <Feature Id="ProductFeature" Title="Hazina Agentic Orchestration" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="WwwRootComponents" />
      <ComponentGroupRef Id="WwwRootAssetsComponents" />
    </Feature>

    <!-- UI -->
    <UIRef Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- License -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!-- Desktop shortcut icon -->
    <Icon Id="AppIcon" SourceFile="$(var.PublishDir)\HazinaOrchestration.exe" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <!-- Launch after install checkbox -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Hazina Orchestration" />
    <Property Id="LAUNCHAPP" Value="1" />
    <CustomAction Id="LaunchApplication"
                  Directory="INSTALLFOLDER"
                  ExeCommand="[INSTALLFOLDER]HazinaOrchestration.exe"
                  Impersonate="yes"
                  Return="asyncNoWait" />
    <UI>
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchApplication">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>
    </UI>
  </Product>

  <!-- Directory Structure -->
  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ManufacturerFolder" Name="Hazina">
          <Directory Id="INSTALLFOLDER" Name="Orchestration">
            <Directory Id="WWWROOT" Name="wwwroot">
              <Directory Id="WWWROOT_ASSETS" Name="assets" />
            </Directory>
          </Directory>
        </Directory>
      </Directory>

      <!-- Start Menu -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Hazina Orchestration" />
      </Directory>
    </Directory>
  </Fragment>

  <!-- Main Application Files -->
  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <!-- Main executable -->
      <Component Id="MainExecutable" Guid="*">
        <File Id="HazinaOrchestrationExe"
              Source="$(var.PublishDir)\HazinaOrchestration.exe"
              KeyPath="yes">
          <Shortcut Id="StartMenuShortcut"
                    Directory="ApplicationProgramsFolder"
                    Name="Hazina Orchestration"
                    Description="Desktop tray application for managing Claude Code CLI instances"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon"
                    Advertise="yes" />
        </File>
      </Component>

      <!-- Config files -->
      <Component Id="ConfigFiles" Guid="*">
        <File Id="AppSettingsJson"
              Source="$(var.PublishDir)\appsettings.json"
              KeyPath="yes" />
      </Component>

      <Component Id="ConfigProduction" Guid="*">
        <File Id="AppSettingsProductionJson"
              Source="$(var.PublishDir)\appsettings.Production.json"
              KeyPath="yes" />
      </Component>

      <!-- Other required files -->
      <Component Id="WebConfigFile" Guid="*">
        <File Id="WebConfig"
              Source="$(var.PublishDir)\web.config"
              KeyPath="yes" />
      </Component>

      <Component Id="StaticWebAssetsFile" Guid="*">
        <File Id="StaticWebAssets"
              Source="$(var.PublishDir)\HazinaOrchestration.staticwebassets.endpoints.json"
              KeyPath="yes" />
      </Component>

      <!-- Remove folders on uninstall -->
      <Component Id="CleanupApplicationFolder" Guid="*">
        <RemoveFolder Id="RemoveApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RemoveFolder Id="RemoveINSTALLFOLDER" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveManufacturerFolder" Directory="ManufacturerFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Hazina\Orchestration" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- wwwroot files -->
  <Fragment>
    <ComponentGroup Id="WwwRootComponents" Directory="WWWROOT">
      <Component Id="IndexHtml" Guid="*">
        <File Id="IndexHtmlFile"
              Source="$(var.PublishDir)\wwwroot\index.html" />
      </Component>
      <Component Id="ViteSvg" Guid="*">
        <File Id="ViteSvgFile"
              Source="$(var.PublishDir)\wwwroot\vite.svg" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- wwwroot/assets files -->
  <Fragment>
    <ComponentGroup Id="WwwRootAssetsComponents" Directory="WWWROOT_ASSETS">
      <Component Id="Assets1" Guid="*">
        <File Id="AssetsCss" Source="$(var.PublishDir)\wwwroot\assets\index-9nNxXUfs.css" />
      </Component>
      <Component Id="Assets2" Guid="*">
        <File Id="AssetsJs" Source="$(var.PublishDir)\wwwroot\assets\index-Bfjjd0MV.js" />
      </Component>
    </ComponentGroup>
  </Fragment>

</Wix>
