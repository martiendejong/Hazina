<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product Id="*"
           Name="Hazina Agentic Orchestration"
           Language="1033"
           Version="2.3.0"
           Manufacturer="Hazina Framework"
           UpgradeCode="12345678-1234-1234-1234-123456789012">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="Hazina Agentic Orchestration Desktop App"
             Comments="Installs Hazina Agentic Orchestration as a desktop tray application (Port 5123)" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Authentication credentials properties -->
    <Property Id="AUTH_USERNAME" Value="admin" />
    <Property Id="AUTH_PASSWORD" Secure="yes" />
    <Property Id="AUTH_PASSWORD_CONFIRM" Secure="yes" />
    <Property Id="SHELL_COMMAND" Value="C:\scripts\claude_agent.bat" />
    <Property Id="WORKING_DIRECTORY" Value="C:\scripts" />

    <!-- Kill any running HazinaOrchestration.exe before install/upgrade -->
    <Property Id="TASKKILL" Value="taskkill.exe" />
    <CustomAction Id="KillRunningProcess"
                  Property="TASKKILL"
                  ExeCommand="/F /IM HazinaOrchestration.exe"
                  Execute="immediate"
                  Return="ignore" />

    <!-- Remove old Windows Service if it exists (migration from v1) -->
    <Property Id="SC_EXE" Value="sc.exe" />
    <CustomAction Id="StopOldService"
                  Property="SC_EXE"
                  ExeCommand="stop HazinaOrchestration"
                  Execute="immediate"
                  Return="ignore" />
    <CustomAction Id="DeleteOldService"
                  Property="SC_EXE"
                  ExeCommand="delete HazinaOrchestration"
                  Execute="immediate"
                  Return="ignore" />

    <!-- Custom action to update credentials (immediate execution - properties work!) -->
    <Property Id="POWERSHELL_EXE" Value="powershell.exe" />
    <CustomAction Id="SetCredentials"
                  Property="POWERSHELL_EXE"
                  ExeCommand="-ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]SetCredentials.ps1&quot; -InstallDir &quot;[INSTALLFOLDER]&quot; -Username &quot;[AUTH_USERNAME]&quot; -Password &quot;[AUTH_PASSWORD]&quot; -ShellCommand &quot;[SHELL_COMMAND]&quot; -WorkingDirectory &quot;[WORKING_DIRECTORY]&quot;"
                  Execute="immediate"
                  Return="check" />

    <!-- Custom action to set file permissions using WixQuietExec pattern -->
    <!-- Step 1: Set command line for WixQuietExec (immediate) -->
    <CustomAction Id="SetFilePermissions_SetCmdLine"
                  Property="SetFilePermissions"
                  Value="&quot;powershell.exe&quot; -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]SetFilePermissions.ps1&quot; -InstallDirParam [INSTALLFOLDER]"
                  Execute="immediate" />
    <!-- Step 2: Execute PowerShell via WixQuietExec (deferred with elevation) -->
    <CustomAction Id="SetFilePermissions"
                  Execute="deferred"
                  Impersonate="no"
                  BinaryKey="WixCA"
                  DllEntry="WixQuietExec"
                  Return="check" />

    <InstallExecuteSequence>
      <Custom Action="KillRunningProcess" Before="InstallValidate">1</Custom>
      <Custom Action="StopOldService" After="KillRunningProcess">1</Custom>
      <Custom Action="DeleteOldService" After="StopOldService">1</Custom>
      <!-- SetCredentials DISABLED for testing -->
      <!-- <Custom Action="SetCredentials" After="InstallFiles">NOT Installed</Custom> -->
      <!-- Set file permissions so regular users can modify appsettings.json -->
      <Custom Action="SetFilePermissions_SetCmdLine" Before="InstallFinalize">1</Custom>
      <Custom Action="SetFilePermissions" After="SetFilePermissions_SetCmdLine">1</Custom>
    </InstallExecuteSequence>

    <Feature Id="ProductFeature" Title="Hazina Agentic Orchestration" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="AppSettingsConfig" />
      <ComponentRef Id="ProductionConfig" />
      <ComponentRef Id="Core_web_config" />
      <ComponentRef Id="Core_entities_yaml" />
      <ComponentRef Id="Core_HazinaOrchestration_staticwebassets_endpoints_json" />
      <ComponentRef Id="IndexHtml" />
      <ComponentRef Id="WwwRoot_index_html_br" />
      <ComponentRef Id="WwwRoot_index_html_gz" />
      <ComponentRef Id="WwwRoot_vite_svg" />
      <ComponentRef Id="WwwRoot_vite_svg_br" />
      <ComponentRef Id="WwwRoot_vite_svg_gz" />
      <ComponentRef Id="AssetFile_index_B24UAhMd_css" />
      <ComponentRef Id="AssetFile_index_B24UAhMd_css_br" />
      <ComponentRef Id="AssetFile_index_B24UAhMd_css_gz" />
      <ComponentRef Id="AssetFile_index_CFANkm62_js" />
      <ComponentRef Id="AssetFile_index_CFANkm62_js_br" />
      <ComponentRef Id="AssetFile_index_CFANkm62_js_gz" />
      <ComponentRef Id="SetupScript" />
      <ComponentRef Id="SetupCmd" />
      <ComponentRef Id="SetupConfigExample" />
      <ComponentRef Id="SetCredentialsScript" />
      <ComponentRef Id="SetFilePermissionsScript" />
      <ComponentRef Id="DataDirectory" />
      <ComponentRef Id="LogsDirectory" />
      <ComponentRef Id="SessionLogsDirectory" />
    </Feature>

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Icon Id="AppIcon" SourceFile="C:\Projects\hazina\apps\Demos\Hazina.Demo.AgenticOrchestration\bin\Release\net9.0\win-x64\publish\HazinaOrchestration.exe" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <!-- Custom UI sequence (WixUI_Common base + our dialogs) -->
    <UIRef Id="WixUI_Common" />
    <WixVariable Id="WixUILicenseRtf" Value="C:\Projects\hazina\apps\Demos\Hazina.Demo.AgenticOrchestration\bin\Release\net9.0\win-x64\publish\License.rtf" />

    <!-- Exit dialog checkbox (checked by default) -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
              Value="Configure network access and security (recommended)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <!-- Launch Setup.ps1 directly (no pause, non-blocking) -->
    <Property Id="WixShellExecTarget" Value="powershell.exe" />
    <Property Id="WixShellExecParams" Value="-NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]Setup.ps1&quot; -Mode interactive -SkipMsiInstall" />
    <CustomAction Id="LaunchSetup" BinaryKey="WixCA" DllEntry="WixShellExec" Impersonate="yes" />

    <!-- Complete custom UI sequence -->
    <UI>
      <!-- Font definitions -->
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />

      <!-- Import standard WiX dialogs -->
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />
      <DialogRef Id="LicenseAgreementDlg" />
      <DialogRef Id="InstallDirDlg" />
      <DialogRef Id="VerifyReadyDlg" />
      <DialogRef Id="ExitDialog" />

      <!-- Our custom credentials dialog -->
      <Dialog Id="CredentialsDlg" Width="370" Height="320" Title="[ProductName] - Configuration">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Set Login Credentials" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="20" Transparent="yes" NoPrefix="yes" Text="Configure login credentials and terminal settings." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="284" Width="370" Height="0" />
        <Control Id="UsernameLabel" Type="Text" X="20" Y="60" Width="290" Height="15" NoPrefix="yes" Text="Username:" />
        <Control Id="UsernameEdit" Type="Edit" X="20" Y="75" Width="320" Height="18" Property="AUTH_USERNAME" />
        <Control Id="PasswordLabel" Type="Text" X="20" Y="100" Width="290" Height="15" NoPrefix="yes" Text="Password:" />
        <Control Id="PasswordEdit" Type="Edit" X="20" Y="115" Width="320" Height="18" Property="AUTH_PASSWORD" Password="yes" />
        <Control Id="ConfirmPasswordLabel" Type="Text" X="20" Y="140" Width="290" Height="15" NoPrefix="yes" Text="Confirm Password:" />
        <Control Id="ConfirmPasswordEdit" Type="Edit" X="20" Y="155" Width="320" Height="18" Property="AUTH_PASSWORD_CONFIRM" Password="yes" />
        <Control Id="ShellCommandLabel" Type="Text" X="20" Y="180" Width="290" Height="15" NoPrefix="yes" Text="Shell Command:" />
        <Control Id="ShellCommandEdit" Type="Edit" X="20" Y="195" Width="320" Height="18" Property="SHELL_COMMAND" />
        <Control Id="WorkingDirectoryLabel" Type="Text" X="20" Y="220" Width="290" Height="15" NoPrefix="yes" Text="Working Directory:" />
        <Control Id="WorkingDirectoryEdit" Type="Edit" X="20" Y="235" Width="320" Height="18" Property="WORKING_DIRECTORY" />
        <Control Id="ErrorText" Type="Text" X="20" Y="260" Width="330" Height="20" NoPrefix="yes" Text="Passwords do not match!" Hidden="yes">
          <Condition Action="show">AUTH_PASSWORD &lt;&gt; AUTH_PASSWORD_CONFIRM AND AUTH_PASSWORD_CONFIRM &lt;&gt; ""</Condition>
          <Condition Action="hide">AUTH_PASSWORD = AUTH_PASSWORD_CONFIRM OR AUTH_PASSWORD_CONFIRM = ""</Condition>
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="293" Width="56" Height="17" Text="&amp;Back">
          <Publish Event="NewDialog" Value="InstallDirDlg">1</Publish>
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="293" Width="56" Height="17" Default="yes" Text="&amp;Next">
          <Publish Event="NewDialog" Value="VerifyReadyDlg">AUTH_PASSWORD = AUTH_PASSWORD_CONFIRM</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="293" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>

      <!-- COMPLETE navigation graph for fresh install -->
      <!-- Welcome -> License -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg">NOT Installed</Publish>
      <!-- License -> InstallDir -->
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg">LicenseAccepted = "1"</Publish>
      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg">1</Publish>
      <!-- InstallDir -> Credentials (THE KEY CHANGE) -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="CredentialsDlg">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2">1</Publish>
      <!-- NOTE: Credentials dialog navigation defined IN the dialog controls above -->
      <!-- VerifyReady -> Back to Credentials -->
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="CredentialsDlg" Order="1">NOT Installed</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2">Installed AND NOT PATCH</Publish>
      <!-- Exit dialog: launch setup script -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchSetup">
        WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed
      </Publish>
    </UI>

  </Product>

  <!-- Directory Structure -->
  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="Hazina Orchestration">
          <Directory Id="WWWROOT" Name="wwwroot">
            <Directory Id="WWWROOT_ASSETS" Name="assets" />
          </Directory>
          <Directory Id="DATADIR" Name="data" />
          <Directory Id="LOGSDIR" Name="logs">
            <Directory Id="LOGS_SESSIONS" Name="agent-sessions" />
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Hazina Orchestration" />
      </Directory>
    </Directory>
  </Fragment>

  <Fragment>
    <Component Id="MainExecutable" Directory="INSTALLFOLDER" Guid="11111111-1111-1111-1111-111111111111">
      <File Id="HazinaOrchestrationExe" Source="C:\Projects\hazina\apps\Demos\Hazina.Demo.AgenticOrchestration\bin\Release\net9.0\win-x64\publish\HazinaOrchestration.exe" KeyPath="yes" />
    </Component>

    <!-- Start Menu shortcut -->
    <Component Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="44444444-4444-4444-4444-444444444444">
      <Shortcut Id="ApplicationStartMenuShortcut"
                Name="Hazina Orchestration"
                Description="Hazina Agentic Orchestration Desktop App"
                Target="[INSTALLFOLDER]HazinaOrchestration.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />
      <RemoveFolder Id="CleanUpShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Hazina\Orchestration" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="AppSettingsConfig" Directory="INSTALLFOLDER" Guid="22222222-2222-2222-2222-222222222222">
