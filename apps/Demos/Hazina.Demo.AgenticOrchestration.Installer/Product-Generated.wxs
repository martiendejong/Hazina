      <File Id="AF_index_jxsYKLC3_css" Source="C:\Projects\hazina\apps\Demos\Hazina.Demo.AgenticOrchestration\bin\Release\net9.0\win-x64\publish\wwwroot\assets\index-jxsYKLC3.css" KeyPath="yes" />
