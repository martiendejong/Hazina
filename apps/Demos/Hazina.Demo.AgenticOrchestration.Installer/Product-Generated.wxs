  <Fragment>
    <Component Id="DataDirectory" Directory="DATADIR" Guid="CCCC1111-1111-1111-1111-111111111111">
      <CreateFolder />
    </Component>
    <Component Id="LogsDirectory" Directory="LOGSDIR" Guid="CCCC2222-2222-2222-2222-222222222222">
      <CreateFolder />
    </Component>
    <Component Id="SessionLogsDirectory" Directory="LOGS_SESSIONS" Guid="CCCC3333-3333-3333-3333-333333333333">
      <CreateFolder />
    </Component>
  </Fragment>

</Wix>
