<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product Id="*"
           Name="Hazina Agentic Orchestration"
           Language="1033"
           Version="2.7.1"
           Manufacturer="Hazina Framework"
           UpgradeCode="12345678-1234-1234-1234-123456789012">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64"
             Description="Hazina Agentic Orchestration Desktop App"
             Comments="Installs Hazina Agentic Orchestration as a desktop tray application (Port 5123)" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- User-configurable properties (set via CredentialsDlg or command line) -->
    <Property Id="AUTH_USERNAME" Value="admin" Secure="yes" />
    <Property Id="AUTH_PASSWORD" Secure="yes" Hidden="yes" />
    <Property Id="AUTH_PASSWORD_CONFIRM" Secure="yes" Hidden="yes" />
    <Property Id="HOST_NAME" Value="localhost" Secure="yes" />
    <Property Id="HOST_PORT" Value="5123" Secure="yes" />
    <Property Id="USE_SSL" Value="1" Secure="yes" />
    <Property Id="TERMINAL_COMMAND" Value="C:\scripts\claude_agent.bat" Secure="yes" />
    <Property Id="TERMINAL_WORKDIR" Value="C:\scripts" Secure="yes" />
    <Property Id="OPENAI_APIKEY" Secure="yes" Hidden="yes" />
    <Property Id="INSTALL_TAILSCALE" Secure="yes" />

    <!-- Kill any running HazinaOrchestration.exe before install/upgrade -->
    <Property Id="TASKKILL" Value="taskkill.exe" />
    <CustomAction Id="KillRunningProcess"
                  Property="TASKKILL"
                  ExeCommand="/F /IM HazinaOrchestration.exe"
                  Execute="immediate"
                  Return="ignore" />

    <!-- Remove old Windows Service if it exists (migration from v1) -->
    <Property Id="SC_EXE" Value="sc.exe" />
    <CustomAction Id="StopOldService"
                  Property="SC_EXE"
                  ExeCommand="stop HazinaOrchestration"
                  Execute="immediate"
                  Return="ignore" />
    <CustomAction Id="DeleteOldService"
                  Property="SC_EXE"
                  ExeCommand="delete HazinaOrchestration"
                  Execute="immediate"
                  Return="ignore" />

    <!-- ConfigTool custom actions: write all user settings to appsettings.json -->

    <!-- 1. Auth: WixSilentExec (password not logged in MSI log) -->
    <CustomAction Id="ConfigureAuthArgs" Property="ConfigureAuth"
                  Value="&quot;[INSTALLFOLDER]HazinaConfigTool.exe&quot; set-auth --username &quot;[AUTH_USERNAME]&quot; --password &quot;[AUTH_PASSWORD]&quot; --config &quot;[INSTALLFOLDER]appsettings.json&quot; --silent --no-backup" />
    <CustomAction Id="ConfigureAuth" BinaryKey="WixCA" DllEntry="WixSilentExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <!-- 2. Kestrel: two conditional args (https or http based on SSL checkbox) -->
    <CustomAction Id="ConfigureKestrelHttpsArgs" Property="ConfigureKestrel"
                  Value="&quot;[INSTALLFOLDER]HazinaConfigTool.exe&quot; set-kestrel --protocol https --host [HOST_NAME] --port [HOST_PORT] --config &quot;[INSTALLFOLDER]appsettings.json&quot; --silent --no-backup" />
    <CustomAction Id="ConfigureKestrelHttpArgs" Property="ConfigureKestrel"
                  Value="&quot;[INSTALLFOLDER]HazinaConfigTool.exe&quot; set-kestrel --protocol http --host [HOST_NAME] --port [HOST_PORT] --config &quot;[INSTALLFOLDER]appsettings.json&quot; --silent --no-backup" />
    <CustomAction Id="ConfigureKestrel" BinaryKey="WixCA" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <!-- 3. Terminal: WixQuietExec (no sensitive data) -->
    <CustomAction Id="ConfigureTerminalArgs" Property="ConfigureTerminal"
                  Value="&quot;[INSTALLFOLDER]HazinaConfigTool.exe&quot; set-terminal --command &quot;[TERMINAL_COMMAND]&quot; --workdir &quot;[TERMINAL_WORKDIR]&quot; --config &quot;[INSTALLFOLDER]appsettings.json&quot; --silent --no-backup" />
    <CustomAction Id="ConfigureTerminal" BinaryKey="WixCA" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <!-- 4. OpenAI: WixSilentExec (API key is sensitive) -->
    <CustomAction Id="ConfigureOpenAIArgs" Property="ConfigureOpenAI"
                  Value="&quot;[INSTALLFOLDER]HazinaConfigTool.exe&quot; set-openai --apikey &quot;[OPENAI_APIKEY]&quot; --config &quot;[INSTALLFOLDER]appsettings.json&quot; --silent --no-backup" />
    <CustomAction Id="ConfigureOpenAI" BinaryKey="WixCA" DllEntry="WixSilentExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <!-- 5. Tailscale: install via winget (conditional, Return=ignore) -->
    <CustomAction Id="InstallTailscaleArgs" Property="InstallTailscale"
                  Value="winget install --id Tailscale.Tailscale --silent --accept-package-agreements --accept-source-agreements" />
    <CustomAction Id="InstallTailscale" BinaryKey="WixCA" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="KillRunningProcess" Before="InstallValidate">1</Custom>
      <Custom Action="StopOldService" After="KillRunningProcess">1</Custom>
      <Custom Action="DeleteOldService" After="StopOldService">1</Custom>
      <!-- After files installed: configure appsettings.json -->
      <Custom Action="ConfigureAuthArgs" After="InstallFiles">NOT REMOVE="ALL"</Custom>
      <Custom Action="ConfigureAuth" After="ConfigureAuthArgs">NOT REMOVE="ALL"</Custom>
      <Custom Action="ConfigureKestrelHttpsArgs" After="ConfigureAuth">USE_SSL = "1" AND NOT REMOVE="ALL"</Custom>
      <Custom Action="ConfigureKestrelHttpArgs" After="ConfigureKestrelHttpsArgs">NOT USE_SSL = "1" AND NOT REMOVE="ALL"</Custom>
      <Custom Action="ConfigureKestrel" After="ConfigureKestrelHttpArgs">NOT REMOVE="ALL"</Custom>
      <Custom Action="ConfigureTerminalArgs" After="ConfigureKestrel">NOT REMOVE="ALL"</Custom>
      <Custom Action="ConfigureTerminal" After="ConfigureTerminalArgs">NOT REMOVE="ALL"</Custom>
      <Custom Action="ConfigureOpenAIArgs" After="ConfigureTerminal">OPENAI_APIKEY AND NOT REMOVE="ALL"</Custom>
      <Custom Action="ConfigureOpenAI" After="ConfigureOpenAIArgs">OPENAI_APIKEY AND NOT REMOVE="ALL"</Custom>
      <Custom Action="InstallTailscaleArgs" After="ConfigureOpenAI">INSTALL_TAILSCALE AND NOT REMOVE="ALL"</Custom>
      <Custom Action="InstallTailscale" After="InstallTailscaleArgs">INSTALL_TAILSCALE AND NOT REMOVE="ALL"</Custom>
    </InstallExecuteSequence>

    <Feature Id="ProductFeature" Title="Hazina Agentic Orchestration" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="AppSettingsConfig" />
      <ComponentRef Id="Core_web_config" />
      <ComponentRef Id="Core_entities_yaml" />
      <ComponentRef Id="Core_HazinaOrchestration_staticwebassets_endpoints_json" />
      <ComponentRef Id="IndexHtml" />
      <ComponentRef Id="WwwRoot_index_html_br" />
      <ComponentRef Id="WwwRoot_index_html_gz" />
      <ComponentRef Id="WwwRoot_vite_svg" />
      <ComponentRef Id="WwwRoot_vite_svg_br" />
      <ComponentRef Id="WwwRoot_vite_svg_gz" />
      <ComponentRef Id="AssetFile_index_CCNS6Xxb_css" />
      <ComponentRef Id="AssetFile_index_CCNS6Xxb_css_br" />
      <ComponentRef Id="AssetFile_index_CCNS6Xxb_css_gz" />
      <ComponentRef Id="AssetFile_index_CXv1Mvak_js" />
      <ComponentRef Id="AssetFile_index_CXv1Mvak_js_br" />
      <ComponentRef Id="AssetFile_index_CXv1Mvak_js_gz" />
      <ComponentRef Id="SetupScript" />
      <ComponentRef Id="SetupCmd" />
      <ComponentRef Id="SetupConfigExample" />
      <ComponentRef Id="SetCredentialsScript" />
      <ComponentRef Id="ConfigTool" />
      <ComponentRef Id="DataDirectory" />
      <ComponentRef Id="LogsDirectory" />
      <ComponentRef Id="SessionLogsDirectory" />
    </Feature>

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Icon Id="AppIcon" SourceFile="C:\Projects\hazina\apps\Demos\Hazina.Demo.AgenticOrchestration\bin\Release\net9.0\win-x64\publish\HazinaOrchestration.exe" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <!-- Custom UI sequence (WixUI_Common base + our dialogs) -->
    <UIRef Id="WixUI_Common" />
    <WixVariable Id="WixUILicenseRtf" Value="C:\Projects\hazina\apps\Demos\Hazina.Demo.AgenticOrchestration\bin\Release\net9.0\win-x64\publish\License.rtf" />

    <!-- Exit dialog checkbox (checked by default) -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
              Value="Launch Hazina Orchestration" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <!-- Launch HazinaOrchestration.exe via ShellExecute after install -->
    <Property Id="WixShellExecTarget" Value="[#HazinaOrchestrationExe]" />
    <CustomAction Id="LaunchApp" BinaryKey="WixCA" DllEntry="WixShellExec" Impersonate="yes" />

    <!-- Complete custom UI sequence -->
    <UI>
      <!-- Font definitions -->
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />

      <!-- Import standard WiX dialogs -->
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />
      <DialogRef Id="LicenseAgreementDlg" />
      <DialogRef Id="InstallDirDlg" />
      <DialogRef Id="CredentialsDlg" />
      <DialogRef Id="VerifyReadyDlg" />
      <DialogRef Id="ExitDialog" />

      <!-- COMPLETE navigation graph for fresh install -->
      <!-- Welcome -> License -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg">NOT Installed</Publish>
      <!-- License -> InstallDir -->
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg">LicenseAccepted = "1"</Publish>
      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg">1</Publish>
      <!-- InstallDir -> Credentials -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="CredentialsDlg">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2">1</Publish>
      <!-- Credentials -> VerifyReady -->
      <Publish Dialog="CredentialsDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="CredentialsDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg">1</Publish>
      <!-- VerifyReady -> Back to Credentials -->
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="CredentialsDlg" Order="1">NOT Installed</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2">Installed AND NOT PATCH</Publish>
      <!-- Exit dialog: launch application (optional) then close -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApp">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1</Publish>
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999">1</Publish>
    </UI>

  </Product>

  <!-- Directory Structure -->
  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="Hazina Orchestration">
          <Directory Id="WWWROOT" Name="wwwroot">
            <Directory Id="WWWROOT_ASSETS" Name="assets" />
          </Directory>
          <Directory Id="DATADIR" Name="data" />
          <Directory Id="LOGSDIR" Name="logs">
            <Directory Id="LOGS_SESSIONS" Name="agent-sessions" />
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Hazina Orchestration" />
      </Directory>
    </Directory>
  </Fragment>

  <Fragment>
    <Component Id="MainExecutable" Directory="INSTALLFOLDER" Guid="11111111-1111-1111-1111-111111111111">
      <File Id="HazinaOrchestrationExe" Source="C:\Projects\hazina\apps\Demos\Hazina.Demo.AgenticOrchestration\bin\Release\net9.0\win-x64\publish\HazinaOrchestration.exe" KeyPath="yes" />
    </Component>

    <!-- Start Menu shortcut -->
    <Component Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="44444444-4444-4444-4444-444444444444">
      <Shortcut Id="ApplicationStartMenuShortcut"
                Name="Hazina Orchestration"
                Description="Hazina Agentic Orchestration Desktop App"
                Target="[INSTALLFOLDER]HazinaOrchestration.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />
      <RemoveFolder Id="CleanUpShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Hazina\Orchestration" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="AppSettingsConfig" Directory="INSTALLFOLDER" Guid="22222222-2222-2222-2222-222222222222">
      <File Id="AppSettingsJson" Source="C:\Projects\hazina\apps\Demos\Hazina.Demo.AgenticOrchestration\bin\Release\net9.0\win-x64\publish\appsettings.json" KeyPath="yes" />
    </Component>

