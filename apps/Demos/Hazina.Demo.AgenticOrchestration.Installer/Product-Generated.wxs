      <File Id="AF_index_CXv1Mvak_js_gz" Source="C:\Projects\hazina\apps\Demos\Hazina.Demo.AgenticOrchestration\bin\Release\net9.0\win-x64\publish\wwwroot\assets\index-CXv1Mvak.js.gz" KeyPath="yes" />
