    </Component>

    <Component Id="WwwRoot_vite_svg_gz" Directory="WWWROOT" Guid="BF5410A3-D947-AAE8-1A1A-4C8B61AD6E5D">
      <File Id="WR_vite_svg_gz" Source="C:\Projects\hazina\apps\Demos\Hazina.Demo.AgenticOrchestration\bin\Release\net9.0\win-x64\publish\wwwroot\vite.svg.gz" KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <Component Id="AssetFile_index_DpVaZMHw_js" Directory="WWWROOT_ASSETS" Guid="C3E61188-9FEB-CE8C-89F6-D0043B75F9E7">
      <File Id="AF_index_DpVaZMHw_js" Source="C:\Projects\hazina\apps\Demos\Hazina.Demo.AgenticOrchestration\bin\Release\net9.0\win-x64\publish\wwwroot\assets\index-DpVaZMHw.js" KeyPath="yes" />
    </Component>
    <Component Id="AssetFile_index_DpVaZMHw_js_br" Directory="WWWROOT_ASSETS" Guid="508F9D61-A9A2-6568-E04F-0E6CE37B191F">
      <File Id="AF_index_DpVaZMHw_js_br" Source="C:\Projects\hazina\apps\Demos\Hazina.Demo.AgenticOrchestration\bin\Release\net9.0\win-x64\publish\wwwroot\assets\index-DpVaZMHw.js.br" KeyPath="yes" />
    </Component>
    <Component Id="AssetFile_index_DpVaZMHw_js_gz" Directory="WWWROOT_ASSETS" Guid="44BE2A3B-B5F2-D5A9-9B44-EF1C147124DE">
