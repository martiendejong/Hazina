<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <UI>
      <!-- Custom dialog for credentials -->
      <Dialog Id="CredentialsDlg" Width="370" Height="270" Title="[ProductName] - Login Credentials">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Set Login Credentials" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="20" Transparent="yes" NoPrefix="yes" Text="Enter the username and password for accessing the web interface." />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <!-- Username -->
        <Control Id="UsernameLabel" Type="Text" X="20" Y="60" Width="290" Height="15" NoPrefix="yes" Text="&amp;Username:" />
        <Control Id="UsernameEdit" Type="Edit" X="20" Y="75" Width="320" Height="18" Property="AUTH_USERNAME" />

        <!-- Password -->
        <Control Id="PasswordLabel" Type="Text" X="20" Y="100" Width="290" Height="15" NoPrefix="yes" Text="&amp;Password:" />
        <Control Id="PasswordEdit" Type="Edit" X="20" Y="115" Width="320" Height="18" Property="AUTH_PASSWORD" Password="yes" />

        <!-- Confirm Password -->
        <Control Id="ConfirmPasswordLabel" Type="Text" X="20" Y="140" Width="290" Height="15" NoPrefix="yes" Text="&amp;Confirm Password:" />
        <Control Id="ConfirmPasswordEdit" Type="Edit" X="20" Y="155" Width="320" Height="18" Property="AUTH_PASSWORD_CONFIRM" Password="yes" />

        <!-- Info text -->
        <Control Id="InfoText" Type="Text" X="20" Y="185" Width="320" Height="30" NoPrefix="yes" Text="These credentials will be required to access the web UI at https://localhost:5123" />

        <!-- Navigation buttons -->
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="DoAction" Value="ValidateCredentials">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>
    </UI>
  </Fragment>
</Wix>
