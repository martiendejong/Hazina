<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <UI>
      <!-- Custom dialog for credentials, web server, terminal, OpenAI, and optional Tailscale -->
      <Dialog Id="CredentialsDlg" Width="370" Height="440" Title="[ProductName] - Configuration">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Configuration Settings" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Enter credentials, web server, and terminal settings." />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />

        <!-- Username -->
        <Control Id="UsernameLabel" Type="Text" X="20" Y="52" Width="290" Height="10" NoPrefix="yes" Text="&amp;Username:" />
        <Control Id="UsernameEdit" Type="Edit" X="20" Y="63" Width="320" Height="18" Property="AUTH_USERNAME" />

        <!-- Password -->
        <Control Id="PasswordLabel" Type="Text" X="20" Y="83" Width="290" Height="10" NoPrefix="yes" Text="&amp;Password:" />
        <Control Id="PasswordEdit" Type="Edit" X="20" Y="94" Width="320" Height="18" Property="AUTH_PASSWORD" Password="yes" />

        <!-- Confirm Password -->
        <Control Id="ConfirmPasswordLabel" Type="Text" X="20" Y="114" Width="290" Height="10" NoPrefix="yes" Text="C&amp;onfirm Password:" />
        <Control Id="ConfirmPasswordEdit" Type="Edit" X="20" Y="125" Width="320" Height="18" Property="AUTH_PASSWORD_CONFIRM" Password="yes" />

        <!-- Web Server section -->
        <Control Id="WebServerLine" Type="Line" X="10" Y="149" Width="350" Height="0" />
        <Control Id="WebServerHeader" Type="Text" X="20" Y="153" Width="290" Height="10" NoPrefix="yes" Text="{\WixUI_Font_Title}Web Server" />

        <!-- Host and Port on same row -->
        <Control Id="HostLabel" Type="Text" X="20" Y="166" Width="150" Height="10" NoPrefix="yes" Text="&amp;Host:" />
        <Control Id="HostEdit" Type="Edit" X="20" Y="177" Width="150" Height="18" Property="HOST_NAME" />

        <Control Id="PortLabel" Type="Text" X="180" Y="166" Width="60" Height="10" NoPrefix="yes" Text="Po&amp;rt:" />
        <Control Id="PortEdit" Type="Edit" X="180" Y="177" Width="55" Height="18" Property="HOST_PORT" />

        <!-- SSL checkbox -->
        <Control Id="SslCheckbox" Type="CheckBox" X="248" Y="177" Width="90" Height="18" Property="USE_SSL" CheckBoxValue="1" Text="Use &amp;SSL" />

        <!-- Terminal section -->
        <Control Id="TerminalLine" Type="Line" X="10" Y="201" Width="350" Height="0" />
        <Control Id="TerminalHeader" Type="Text" X="20" Y="205" Width="290" Height="10" NoPrefix="yes" Text="{\WixUI_Font_Title}Terminal Configuration" />

        <!-- Shell Command -->
        <Control Id="ShellCommandLabel" Type="Text" X="20" Y="218" Width="290" Height="10" NoPrefix="yes" Text="S&amp;hell Command:" />
        <Control Id="ShellCommandEdit" Type="Edit" X="20" Y="229" Width="320" Height="18" Property="TERMINAL_COMMAND" />

        <!-- Working Directory -->
        <Control Id="WorkDirLabel" Type="Text" X="20" Y="249" Width="290" Height="10" NoPrefix="yes" Text="&amp;Working Directory:" />
        <Control Id="WorkDirEdit" Type="Edit" X="20" Y="260" Width="320" Height="18" Property="TERMINAL_WORKDIR" />

        <!-- Optional section -->
        <Control Id="OptionalLine" Type="Line" X="10" Y="284" Width="350" Height="0" />
        <Control Id="OptionalHeader" Type="Text" X="20" Y="288" Width="290" Height="10" NoPrefix="yes" Text="{\WixUI_Font_Title}Optional" />

        <!-- OpenAI API Key -->
        <Control Id="OpenAiLabel" Type="Text" X="20" Y="302" Width="290" Height="10" NoPrefix="yes" Text="Open&amp;AI API Key:" />
        <Control Id="OpenAiEdit" Type="Edit" X="20" Y="313" Width="320" Height="18" Property="OPENAI_APIKEY" />

        <!-- Tailscale checkbox -->
        <Control Id="TailscaleCheckbox" Type="CheckBox" X="20" Y="338" Width="320" Height="18" Property="INSTALL_TAILSCALE" CheckBoxValue="1" Text="Install and configure &amp;Tailscale" />
        <Control Id="TailscaleInfo" Type="Text" X="36" Y="355" Width="300" Height="10" NoPrefix="yes" Text="Requires internet access. Provides automatic HTTPS certificates." />

        <!-- Info text -->
        <Control Id="InfoText" Type="Text" X="20" Y="370" Width="320" Height="18" NoPrefix="yes" Text="All settings are saved to appsettings.json and can be changed later." />

        <!-- Bottom line and navigation -->
        <Control Id="BottomLine" Type="Line" X="0" Y="396" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="406" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="406" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="406" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>
    </UI>
  </Fragment>
</Wix>
