<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Hazina Orchestration"
           Language="1033"
           Version="2.5.0.0"
           Manufacturer="Martien de Jong"
           UpgradeCode="49344482-446f-483f-ac0f-918b0d3e2d96">

    <Package InstallerVersion="200"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64"
             Description="Hazina Agentic Orchestration - Desktop tray application for managing Claude Code CLI instances"
             Comments="Version 2.5.0 with JWT Authentication" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="Hazina Orchestration" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="WwwrootComponents" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <!-- UI for installation -->
    <UIRef Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!-- Desktop shortcut -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- Start Menu shortcut -->
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="3c78f0ab-9850-4e89-bc0b-253c613bc9af">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="Hazina Orchestration"
                  Description="Desktop tray application for managing Claude Code CLI instances"
                  Target="[INSTALLFOLDER]HazinaOrchestration.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\HazinaOrchestration"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Hazina Orchestration" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Hazina Orchestration" />
      </Directory>
    </Directory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="HazinaOrchestration.exe" Guid="a273cde2-34b4-4fd9-b46e-8b11336746bc" Win64="yes">
        <File Id="HazinaOrchestration.exe"
              Source="$(var.PublishDir)HazinaOrchestration.exe"
              KeyPath="yes"
              Checksum="yes" />
      </Component>

      <Component Id="AppSettings" Guid="4e2f8224-ed77-449e-bebe-fb3c81095e9d" Win64="yes">
        <File Id="appsettings.json" Source="$(var.PublishDir)appsettings.json" />
        <File Id="appsettings.Production.json" Source="$(var.PublishDir)appsettings.Production.json" />
      </Component>

      <Component Id="WebConfig" Guid="c4de21b4-0f15-4392-9124-567d7228f7ff" Win64="yes">
        <File Id="web.config" Source="$(var.PublishDir)web.config" />
        <File Id="HazinaOrchestration.staticwebassets.endpoints.json"
              Source="$(var.PublishDir)HazinaOrchestration.staticwebassets.endpoints.json" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="WwwrootComponents" Directory="INSTALLFOLDER">
      <Component Id="Wwwroot" Guid="85469f4c-d9fe-4f49-a119-f2cab58086ff" Win64="yes">
        <File Id="wwwroot_index.html" Source="$(var.PublishDir)wwwroot\index.html" />
      </Component>
      <Component Id="WwwrootAssets" Guid="976f98cd-a3c1-49cb-b824-cb3d86e7eee0" Win64="yes">
        <File Id="wwwroot_assets_css" Source="$(var.PublishDir)wwwroot\assets\index-CDIpq_jv.css" />
        <File Id="wwwroot_assets_js" Source="$(var.PublishDir)wwwroot\assets\index-CAqNMBij.js" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
