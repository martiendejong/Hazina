import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest'
import { renderHook, act } from '@testing-library/react'
import { useVoiceControl } from './useVoiceControl'

// Mock SpeechRecognition
class MockSpeechRecognition {
  continuous = false
  interimResults = false
  lang = ''
  onstart: (() => void) | null = null
  onend: (() => void) | null = null
  onresult: ((event: unknown) => void) | null = null
  onerror: ((event: unknown) => void) | null = null
  onnomatch: (() => void) | null = null

  start() {
    this.onstart?.()
  }

  stop() {
    this.onend?.()
  }

  abort() {
    this.onend?.()
  }
}

describe('useVoiceControl', () => {
  let originalSpeechRecognition: typeof window.SpeechRecognition

  beforeEach(() => {
    // Save original
    originalSpeechRecognition = window.SpeechRecognition

    // Set up mock
    ;(window as unknown as { SpeechRecognition: typeof MockSpeechRecognition }).SpeechRecognition = MockSpeechRecognition
  })

  afterEach(() => {
    // Restore original
    ;(window as unknown as { SpeechRecognition: typeof window.SpeechRecognition }).SpeechRecognition = originalSpeechRecognition
  })

  it('should detect speech recognition support', () => {
    const onTranscript = vi.fn()
    const { result } = renderHook(() => useVoiceControl(onTranscript))

    const [state] = result.current
    expect(state.isSupported).toBe(true)
  })

  it('should detect when speech recognition is not supported', () => {
    // Remove SpeechRecognition
    delete (window as unknown as { SpeechRecognition?: unknown }).SpeechRecognition
    delete (window as unknown as { webkitSpeechRecognition?: unknown }).webkitSpeechRecognition

    const onTranscript = vi.fn()
    const { result } = renderHook(() => useVoiceControl(onTranscript))

    const [state] = result.current
    expect(state.isSupported).toBe(false)
  })

  it('should toggle listening state', () => {
    const onTranscript = vi.fn()
    const { result } = renderHook(() => useVoiceControl(onTranscript))

    // Initially not listening
    expect(result.current[0].isListening).toBe(false)

    // Start listening
    act(() => {
      result.current[1].start()
    })
    expect(result.current[0].isListening).toBe(true)

    // Stop listening
    act(() => {
      result.current[1].stop()
    })
    expect(result.current[0].isListening).toBe(false)
  })

  it('should toggle via toggle action', () => {
    const onTranscript = vi.fn()
    const { result } = renderHook(() => useVoiceControl(onTranscript))

    // Toggle on
    act(() => {
      result.current[1].toggle()
    })
    expect(result.current[0].isListening).toBe(true)

    // Toggle off
    act(() => {
      result.current[1].toggle()
    })
    expect(result.current[0].isListening).toBe(false)
  })

  it('should clear error state when starting', () => {
    const onTranscript = vi.fn()
    const { result } = renderHook(() => useVoiceControl(onTranscript))

    // Start should clear any error
    act(() => {
      result.current[1].start()
    })
    expect(result.current[0].error).toBeNull()
  })

  it('should provide all required actions', () => {
    const onTranscript = vi.fn()
    const { result } = renderHook(() => useVoiceControl(onTranscript))

    const [, actions] = result.current
    expect(typeof actions.start).toBe('function')
    expect(typeof actions.stop).toBe('function')
    expect(typeof actions.toggle).toBe('function')
  })

  it('should provide correct initial state', () => {
    const onTranscript = vi.fn()
    const { result } = renderHook(() => useVoiceControl(onTranscript))

    const [state] = result.current
    expect(state.isListening).toBe(false)
    expect(state.interimTranscript).toBe('')
    expect(state.error).toBeNull()
  })
})
