    <ProjectReference Include="..\..\..\src\Core\AI\Hazina.AI.RAG\Hazina.AI.RAG.csproj" />
    <ProjectReference Include="..\..\..\src\Core\AI\Hazina.AI.Agents\Hazina.AI.Agents.csproj" />
    <ProjectReference Include="..\..\..\src\Core\AI\Hazina.Neurochain.Core\Hazina.Neurochain.Core.csproj" />
    <ProjectReference Include="..\..\..\src\Core\AI\Hazina.AI.Providers\Hazina.AI.Providers.csproj" />
    <ProjectReference Include="..\..\..\src\Core\AI\Hazina.AI.FaultDetection\Hazina.AI.FaultDetection.csproj" />
    <ProjectReference Include="..\..\..\src\Core\Storage\Hazina.Store.DocumentStore\Hazina.Store.DocumentStore.csproj" />
    <ProjectReference Include="..\..\..\src\Core\Storage\Hazina.Store.EmbeddingStore\Hazina.Store.EmbeddingStore.csproj" />
    <ProjectReference Include="..\..\..\src\Core\LLMs.Providers\Hazina.LLMs.OpenAI\Hazina.LLMs.OpenAI.csproj" />
    <ProjectReference Include="..\..\..\src\Core\LLMs.Providers\Hazina.LLMs.Anthropic\Hazina.LLMs.Anthropic.csproj" />
    <ProjectReference Include="..\..\..\src\Core\LLMs\Hazina.LLMs.Client\Hazina.LLMs.Client.csproj" />
