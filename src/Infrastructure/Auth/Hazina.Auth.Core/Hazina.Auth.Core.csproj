<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>Hazina.Auth.Core</PackageId>
    <Description>Core models, interfaces, and DTOs for the Hazina authentication system. Provider-agnostic foundation consumed by Hazina.Auth.Identity and other Hazina.Auth.* providers.</Description>
    <PackageTags>hazina;authentication;identity;oauth;jwt</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.0" />
  </ItemGroup>

</Project>
