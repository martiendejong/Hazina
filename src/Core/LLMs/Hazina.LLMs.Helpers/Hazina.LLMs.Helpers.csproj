<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LanguageVersion>latest</LanguageVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Hazina.LLMs</RootNamespace>
    <Description>Utility functions for document and token processing. Token counting, document splitting, partial JSON parsing, and embedding helpers.</Description>
    <PackageTags>hazina;llm;helpers;tokens;document-splitting;chunking;utilities</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
    <PackageId>Hazina.LLMs.Helpers</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="SharpToken" Version="2.0.3" />
  </ItemGroup>
</Project>