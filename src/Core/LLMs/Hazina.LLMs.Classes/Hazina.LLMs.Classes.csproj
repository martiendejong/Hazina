<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LanguageVersion>latest</LanguageVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Hazina.LLMs</RootNamespace>
    <Description>Core data models and contracts for the Hazina LLM ecosystem. Chat message models, response wrappers, token usage tracking, tool definitions, and shared interfaces.</Description>
    <PackageTags>hazina;llm;models;contracts;chat;tokens;tool-calling</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
    <PackageId>Hazina.LLMs.Classes</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Memory.Data" Version="6.0.0" />
  </ItemGroup>
</Project>