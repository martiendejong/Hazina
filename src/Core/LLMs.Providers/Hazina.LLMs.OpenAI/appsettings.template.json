        "Tier": "Basic",
        "UseLLM": false,
        "LLMModel": "gpt-4o-mini",
        "BatchLLMCalls": true,
        "MaxBatchSize": 10,
        "TopKeywordsCount": 5
      },
      "Advanced": {
        "UseHierarchical": false,
        "HierarchicalSectionSize": 5000,
        "FallbackStrategy": "Paragraph",
        "CacheEmbeddings": true,
        "ContentType": null
      }
    }
