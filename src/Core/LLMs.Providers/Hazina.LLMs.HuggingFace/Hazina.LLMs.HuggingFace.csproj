<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LanguageVersion>latest</LanguageVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Hazina.LLMs</RootNamespace>
    <Description>HuggingFace implementation of ILLMClient for Hazina. Access open-source models via HuggingFace Inference API including Llama, Mixtral, embeddings, and image generation.</Description>
    <PackageTags>hazina;huggingface;llm;open-source;llama;mixtral;embeddings;transformers</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
    <PackageId>Hazina.LLMs.HuggingFace</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\LLMs\Hazina.LLMs.Client\Hazina.LLMs.Client.csproj" />
    <ProjectReference Include="..\..\LLMs\Hazina.LLMs.Classes\Hazina.LLMs.Classes.csproj" />
    <ProjectReference Include="..\..\LLMs\Hazina.LLMs.Helpers\Hazina.LLMs.Helpers.csproj" />
  </ItemGroup>
</Project>