<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Hazina.Indexing</PackageId>
    <Description>Indexing primitives for Hazina: contracts and helpers for incremental ingestion, content hashing, batch indexing, and rebuild orchestration across DocumentStore/EmbeddingStore backends.</Description>
    <PackageTags>hazina;indexing;ingestion;rag;embeddings;documents</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />
  </ItemGroup>

</Project>
