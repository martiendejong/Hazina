<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LanguageVersion>latest</LanguageVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Hazina.Store.Faiss</RootNamespace>
    <Version>2.0.0</Version>
    <PackageVersion>2.0.0</PackageVersion>
    <Authors>Martien de Jong</Authors>
    <Description>FAISS-compatible in-memory vector store adapter for Hazina. Implements IEmbeddingStore and IVectorSearchStore with an in-memory index and extensible IFaissIndexBackend hook for native FAISS bindings. Ideal for fast prototyping and test scenarios.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/martiendejong/Hazina</PackageProjectUrl>
    <RepositoryUrl>https://github.com/martiendejong/Hazina.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>faiss;vector-store;embeddings;similarity-search;in-memory;rag;ann</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hazina.Store.EmbeddingStore\Hazina.Store.EmbeddingStore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />
  </ItemGroup>
</Project>
