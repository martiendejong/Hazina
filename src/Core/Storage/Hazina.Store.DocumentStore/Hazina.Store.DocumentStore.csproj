<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Hazina.Store</RootNamespace>
    <PackageId>Hazina.Store.DocumentStore</PackageId>
    <Description>Document storage and retrieval for RAG (Retrieval-Augmented Generation) in Hazina. Provides IDocumentStore with text/binary documents, chunking, metadata management, and relevancy matching. Includes file-based, memory-based, and Postgres/Supabase backends.</Description>
    <PackageTags>hazina;rag;document-store;retrieval;storage;chunking;embeddings;semantic-search</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hazina.Store.EmbeddingStore\Hazina.Store.EmbeddingStore.csproj" />
    <ProjectReference Include="..\..\LLMs\Hazina.LLMs.Helpers\Hazina.LLMs.Helpers.csproj" />
    <ProjectReference Include="..\..\AI\Hazina.AI.Providers\Hazina.AI.Providers.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.3" />
    <PackageReference Include="Supabase" Version="1.1.1" />
  </ItemGroup>
</Project>
