<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Hazina.Store.Sqlite</RootNamespace>
    <PackageId>Hazina.Store.Sqlite</PackageId>
    <Description>SQLite-based storage backend for Hazina. Single-file database storage with FTS5 full-text search, vector similarity search, metadata querying, and file checksum tracking for rebuildability. Ideal for local development and embedded scenarios.</Description>
    <PackageTags>hazina;sqlite;storage;embeddings;vector-store;fts5;metadata;rag;local-database</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\LLMs\Hazina.LLMs.Helpers\Hazina.LLMs.Helpers.csproj" />
    <ProjectReference Include="..\..\LLMs\Hazina.LLMs.Client\Hazina.LLMs.Client.csproj" />
    <ProjectReference Include="..\Hazina.Store.EmbeddingStore\Hazina.Store.EmbeddingStore.csproj" />
    <ProjectReference Include="..\Hazina.Store.DocumentStore\Hazina.Store.DocumentStore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />
  </ItemGroup>
</Project>
