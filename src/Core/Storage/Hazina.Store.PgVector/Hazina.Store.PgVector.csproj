<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LanguageVersion>latest</LanguageVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Hazina.Store.PgVector</RootNamespace>
    <Version>2.0.0</Version>
    <PackageVersion>2.0.0</PackageVersion>
    <Authors>Martien de Jong</Authors>
    <Description>PostgreSQL + pgvector storage adapter for Hazina. Provides native vector similarity search using pgvector's HNSW and IVFFlat indices. Designed for production workloads with large embedding datasets. Implements IEmbeddingStore, IVectorSearchStore, and IBatchEmbeddingStore.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/martiendejong/Hazina</PackageProjectUrl>
    <RepositoryUrl>https://github.com/martiendejong/Hazina.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>postgresql;pgvector;vector-store;embeddings;semantic-search;rag;hnsw;ivfflat;similarity</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hazina.Store.EmbeddingStore\Hazina.Store.EmbeddingStore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />
    <PackageReference Include="Npgsql" Version="8.0.3" />
    <PackageReference Include="Pgvector" Version="0.2.0" />
  </ItemGroup>
</Project>
