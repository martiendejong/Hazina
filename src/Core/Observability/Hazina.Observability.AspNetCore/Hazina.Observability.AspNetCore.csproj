<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>Hazina.Observability.AspNetCore</PackageId>
    <Description>ASP.NET Core integration for Hazina.Observability.Core: request/response tracing middleware, Prometheus scrape endpoint, and DI extensions to wire OpenTelemetry into web applications.</Description>
    <PackageTags>hazina;observability;aspnetcore;opentelemetry;prometheus;middleware;tracing;metrics</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Routing" Version="2.2.2" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.11.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.11.0" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hazina.Observability.Core\Hazina.Observability.Core.csproj" />
  </ItemGroup>
</Project>
