<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Hazina.AI.Training</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Prospergenics</Authors>
    <Description>Model training capabilities for Hazina using TorchSharp. Includes LoRA fine-tuning, training loops, and checkpoint management.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- TorchSharp - base package -->
    <PackageReference Include="TorchSharp" Version="0.105.2" />
    <!-- Optional GPU packages - user should add one of these for GPU support:
    <PackageReference Include="TorchSharp-cuda-windows" Version="0.105.2" />
    <PackageReference Include="TorchSharp-cuda-linux" Version="0.105.2" />
    <PackageReference Include="libtorch-cuda-12.8-win-x64" Version="2.7.1.1" />
    -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hazina.AI.Core\Hazina.AI.Core.csproj" />
  </ItemGroup>
</Project>
