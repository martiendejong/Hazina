<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Hazina.AI.TaskPrediction</RootNamespace>
    <Description>Task complexity prediction and scope estimation using learned models. Works with ClickUp, GitHub, Jira, and other task systems.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
    <PackageId>Hazina.AI.TaskPrediction</PackageId>
    <PackageTags>hazina;ai;task-prediction;estimation;complexity;planning</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.3" />
    <PackageReference Include="System.Text.Json" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hazina.AI.Core\Hazina.AI.Core.csproj" />
  </ItemGroup>
</Project>