<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Hazina.AI.Inference</RootNamespace>
    <Description>ONNX Runtime model inference for Hazina. Run ONNX models with CPU, CUDA, DirectML, or TensorRT acceleration.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
    <PackageId>Hazina.AI.Inference</PackageId>
    <PackageTags>hazina;ai;inference;onnx;gpu;acceleration</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!-- ONNX Runtime - base package required -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <!-- Optional GPU packages - user should add one of these:
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.20.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.20.1" />
    -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hazina.AI.Core\Hazina.AI.Core.csproj" />
  </ItemGroup>
</Project>