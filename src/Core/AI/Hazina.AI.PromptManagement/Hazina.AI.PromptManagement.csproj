<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>Prompt management system with template versioning, evaluation, and self-learning capabilities.</Description>
    <PackageId>Hazina.AI.PromptManagement</PackageId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
    <PackageTags>hazina;ai;prompts;templates;versioning;evaluation</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exclude problematic files with dynamic type issues -->
    <Compile Remove="Storage.PostgreSQL\**" />
    <Compile Remove="Dashboard\AlertingService.cs" />
    <Compile Remove="Safety\SafetyCoordinator.cs" />
    <Compile Remove="Approval\ApprovalWorkflow.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Handlebars template engine -->
    <PackageReference Include="Handlebars.Net" Version="2.1.6" />
    <!-- Database access -->
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Npgsql" Version="8.0.5" />
    <!-- JSON -->
    <PackageReference Include="System.Text.Json" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Hazina dependencies -->
    <ProjectReference Include="..\..\LLMs\Hazina.LLMs.Client\Hazina.LLMs.Client.csproj" />
    <ProjectReference Include="..\..\LLMs\Hazina.LLMs.Classes\Hazina.LLMs.Classes.csproj" />
  </ItemGroup>
</Project>