          "rawSql": "SELECT\n  date_trunc('$granularity', er.started_at) as time,\n  AVG((er.metrics->>'Latency')::float) as \"Average\",\n  PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY (er.metrics->>'Latency')::float) as \"P95\",\n  MAX((er.metrics->>'Latency')::float) as \"Max\"\nFROM eval_runs er\nWHERE er.prompt_id = '$prompt_id'\n  AND er.status = 'completed'\n  AND $__timeFilter(er.started_at)\nGROUP BY time\nORDER BY time",
