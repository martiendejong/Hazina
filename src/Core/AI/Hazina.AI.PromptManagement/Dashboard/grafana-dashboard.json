        {
          "format": "table",
          "group": [],
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "SELECT\n  CASE\n    WHEN (er.metrics->>'Overall')::float >= 0.8 THEN 'Excellent (≥0.8)'\n    WHEN (er.metrics->>'Overall')::float >= 0.6 THEN 'Good (0.6-0.8)'\n    WHEN (er.metrics->>'Overall')::float >= 0.4 THEN 'Fair (0.4-0.6)'\n    ELSE 'Poor (<0.4)'\n  END as quality_tier,\n  COUNT(*) as count\nFROM eval_runs er\nWHERE er.prompt_id = '$prompt_id'\n  AND er.status = 'completed'\n  AND $__timeFilter(er.started_at)\nGROUP BY quality_tier",
          "refId": "A",
          "select": [
            [
