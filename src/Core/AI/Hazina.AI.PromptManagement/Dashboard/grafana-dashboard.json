          "rawQuery": true,
          "rawSql": "SELECT\n  timestamp,\n  severity,\n  type,\n  title,\n  message,\n  recommended_actions::text as actions\nFROM alerts\nWHERE prompt_id = '$prompt_id'\n  AND acknowledged = false\n  AND $__timeFilter(timestamp)\nORDER BY\n  CASE severity\n    WHEN 'critical' THEN 1\n    WHEN 'high' THEN 2\n    WHEN 'medium' THEN 3\n    WHEN 'low' THEN 4\n  END,\n  timestamp DESC\nLIMIT 50",
