          "rawQuery": true,
          "rawSql": "SELECT\n  date_trunc('$granularity', er.started_at) as time,\n  AVG((er.metrics->>'Accuracy')::float) as \"Accuracy\",\n  AVG((er.metrics->>'Relevance')::float) as \"Relevance\",\n  AVG((er.metrics->>'Clarity')::float) as \"Clarity\",\n  AVG((er.metrics->>'Overall')::float) as \"Overall\"\nFROM eval_runs er\nWHERE er.prompt_id = '$prompt_id'\n  AND er.status = 'completed'\n  AND $__timeFilter(er.started_at)\nGROUP BY time\nORDER BY time",
