          "rawQuery": true,
          "rawSql": "SELECT\n  pv.version_number::text || ' (v' || pv.version_number || ')' as metric,\n  AVG((er.metrics->>'Overall')::float) as value\nFROM eval_runs er\nJOIN prompt_versions pv ON er.version_id = pv.version_id\nWHERE er.prompt_id = '$prompt_id'\n  AND er.status = 'completed'\n  AND $__timeFilter(er.started_at)\nGROUP BY pv.version_number\nORDER BY pv.version_number DESC\nLIMIT 10",
