<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Hazina.AI.Vision</RootNamespace>
    <Description>Vision and video understanding pipelines. Includes V-JEPA 2 video embeddings, image encoding, and multi-modal AI integration.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
    <PackageId>Hazina.AI.Vision</PackageId>
    <PackageTags>hazina;ai;vision;video;image;multi-modal;vjepa</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!-- Image processing -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.6" />
    <!-- Video frame extraction -->
    <PackageReference Include="FFMpegCore" Version="5.1.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hazina.AI.Core\Hazina.AI.Core.csproj" />
    <ProjectReference Include="..\Hazina.AI.Inference\Hazina.AI.Inference.csproj" />
  </ItemGroup>
</Project>