<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>Hazina.Security.AspNetCore</PackageId>
    <Description>ASP.NET Core wiring for Hazina.Security.Core: DI extensions, middleware, and security headers/policies for hardening Hazina-based web applications.</Description>
    <PackageTags>hazina;security;aspnetcore;middleware;hardening;data-protection</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hazina.Security.Core\Hazina.Security.Core.csproj" />
  </ItemGroup>
</Project>
