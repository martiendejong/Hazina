<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Hazina.Tools.Services.WebSearch</PackageId>
    <Description>Web search tools and providers for the Hazina AI framework.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebSearch.Core\WebSearch.Core.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
    <ProjectReference Include="..\WebSearch.Providers\WebSearch.Providers.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
    <ProjectReference Include="..\WebSearch.Infrastructure\WebSearch.Infrastructure.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
