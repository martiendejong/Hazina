<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MinimalConsoleApp</RootNamespace>

    <!-- Suppress analyzer warnings for quickstart template clarity -->
    <NoWarn>CS1591;CA1852;SA1200;SA1633;MA0004</NoWarn>

    <!-- Disable RestorePackagesWithLockFile inherited from Directory.Build.props for standalone use -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Hazina.AgentFactory is the core package for bootstrapping agents.
      It pulls in everything you need:
        - ILLMClient abstraction
        - AgentManager + HazinaAgent
        - Document & Embedding stores
        - Built-in tool collections (file ops, git, dotnet, etc.)
    -->
    <ProjectReference Include="..\..\src\Core\Agents\Hazina.AgentFactory\Hazina.AgentFactory.csproj" />
    <ProjectReference Include="..\..\src\Core\LLMs.Providers\Hazina.LLMs.OpenAI\Hazina.LLMs.OpenAI.csproj" />
    <ProjectReference Include="..\..\src\Core\LLMs.Providers\Hazina.LLMs.Anthropic\Hazina.LLMs.Anthropic.csproj" />
  </ItemGroup>

</Project>
